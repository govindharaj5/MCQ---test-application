# Copy this file to .env and adjust values before running the server.

# Server
PORT=5000

# Admin account — seeded into the database automatically on first run.
# Changing these AFTER the first run will NOT update an already-seeded
# account; use the "change password" feature in the admin panel instead,
# or delete backend/data/mcqtest.db to force a fresh reseed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=jana123

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS — the origin allowed to call the API. Use '*' for local development,
# or your deployed frontend URL in production (e.g. https://yourapp.com).
CORS_ORIGIN=*

# Optional: override where the SQLite database file is stored.
# DB_PATH=./data/mcqtest.db
